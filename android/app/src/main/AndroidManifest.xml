<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pleos Vehicle SDK: Brake·Gear·Odometer (docs/pleos/vehicle-sdk.md) -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />

    <!-- Pleos Vehicle SDK: Fuel·EvBattery 잔량(normal, docs/pivot-fuel.md 1장) -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <!-- Pleos 배터리 용량(getEvBatteryCapacity)은 CAR_ENERGY만으로는 SecurityException이 난다(2026-11-04 에뮬레이터, normal) -->
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />

    <!-- Pleos NaviHelper 위치·목적지 조회 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <!-- Pleos NaviHelper 경유지 추가·경로 요청(normal, docs/pleos/navihelper-sdk.md) -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />

    <!-- AAOS: 속도(dangerous, 런타임 허용 필요)·기어 -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />
    <!-- AAOS: 연료 종류·탱크 용량(normal) -->
    <uses-permission android:name="android.car.permission.CAR_INFO" />

    <!-- 오피넷 전국 평균 유가(하루 한 번, 위치를 보내지 않음) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 수집 서비스(포그라운드) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />

    <application
        android:label="Fuel Mate"
        android:allowBackup="false">

        <!-- CCP(다이얼) 미지원 선언 -->
        <meta-data android:name="com.hmg.rotary.ROTARY_SUPPORTED" android:value="false" />

        <uses-library android:name="android.car" android:required="false" />

        <!-- 화면은 하나만 둔다: 다시 열어도 새로 쌓지 않고 있는 화면을 앞으로 가져온다 -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <!-- 주행 중에도 한 줄 요약을 보여준다. 없으면 주행 중 차단된다(docs/pleos/driving-restriction.md) -->
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.CollectorService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
