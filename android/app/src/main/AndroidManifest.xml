<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pleos Vehicle SDK (docs/pleos/vehicle-sdk.md 퍼미션 표) -->
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- 경고등: 실차에서 부여되는지 모름. 못 쓰면 숨긴다 -->
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
    <uses-permission android:name="pleos.car.permission.PRIVATE_CAR_SAFETY" />

    <!-- Pleos NaviHelper 위치·목적지 조회 -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />

    <!-- AAOS: 속도(dangerous, 런타임 허용 필요)·기어 -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />

    <!-- 서버 업로드·구독 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 수집 서비스(포그라운드) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />

    <application
        android:label="Road Sensor"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- CCP(다이얼) 미지원 선언 -->
        <meta-data android:name="com.hmg.rotary.ROTARY_SUPPORTED" android:value="false" />

        <uses-library android:name="android.car" android:required="false" />

        <!-- 화면은 하나만 둔다: 작업 표시줄·앞길 알림으로 다시 열어도 새로 쌓지 않고 있는 화면을 앞으로 가져온다 -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <!-- 주행 중에도 한 줄 알림을 보여준다. 없으면 주행 중 차단된다(docs/pleos/driving-restriction.md) -->
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.CollectorService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
